# Backend on your PC (default port 5000: `npm run dev` in ghar-dekho-backend).
#
# Android emulator / USB device: use localhost here and port forwarding:
#   npm run android   (runs `adb reverse tcp:5000 tcp:5000` first)
#   OR after emulator is up: npm run reverse-api
# This avoids ERR_NETWORK when 10.0.2.2 is blocked (common on Windows).
# API_BASE_URL=http://127.0.0.1:5000
#
# Android emulator without adb reverse (less reliable on Windows):
# API_BASE_URL=http://10.0.2.2:5000
#
# Genymotion maps the host as 10.0.3.2 instead of 10.0.2.2:
# API_BASE_URL=http://10.0.3.2:5000
#
# Physical phone on Wi‑Fi only (no USB / no reverse): PC IPv4 from ipconfig.
# API_BASE_URL=http://192.168.29.178:5000
# API_BASE_URL=http://localhost:5000
# API_BASE_URL=https://ghar-dekho-backend-vdbd.onrender.com
# CHAT_SOCKET_URL=https://ghar-dekho-backend-vdbd.onrender.com
#
API_BASE_URL=https://ghar-dekho-backend.vercel.app
