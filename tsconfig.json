{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "types": ["nativewind/types", "jest"],
    "resolveJsonModule": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.d.ts",
    "nativewind.d.js"
  ],
  "exclude": [
    "node_modules",
    "android",
    "ios",
    "**/node_modules/**"
  ]
}
